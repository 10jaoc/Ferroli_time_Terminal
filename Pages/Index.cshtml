@page
@model IndexModel
@using FerroliTime.Terminal.Services
@{ ViewData["Title"] = "Marcajes"; }

@if (TempData["ResultadoTipo"] is string tipoResultado)
{
  @* Resultado del fichaje: se cierra solo a los SegundosMensaje (o al tocarlo). *@
  <div class="resultado-fichaje @tipoResultado" data-cerrar="@Model.SegundosMensaje" role="alert">
    <div class="caja">
      <div class="titulo">@TempData["ResultadoTitulo"]</div>
      <div class="texto">@TempData["ResultadoTexto"]</div>
      <div class="cuenta">Se cierra en <span data-cuenta>@Model.SegundosMensaje</span> s</div>
      <button type="button" class="secundario">Cerrar</button>
    </div>
  </div>
}

@if (Model.Terminal.Tipo == TipoTerminal.NoAutorizado)
{
  <div class="panel cerrado">
    <h1>Terminal no autorizado</h1>
    <p>Este equipo no está dado de alta para fichar.</p>
    <p class="detalle">IP: <strong>@(string.IsNullOrEmpty(Model.Terminal.Ip) ? "desconocida" : Model.Terminal.Ip)</strong></p>
    <p class="detalle">Si debería poder fichar desde aquí, comunique esta IP al administrador.</p>
  </div>
  return;
}

@if (!Model.Abierto)
{
  <div class="panel cerrado">
    <h1>Sistema cerrado</h1>
    <p>No se pueden realizar marcajes.</p>
    <p class="detalle">@Model.MotivoCerrado</p>
    <p class="detalle">@Model.Ahora.ToString("dd/MM/yyyy HH:mm:ss")</p>
  </div>
  return;
}

<div class="panel">
  <h1>Introducción de marcajes</h1>

  @if (!string.IsNullOrEmpty(Model.Error))
  {
    <div class="alerta error">@Model.Error</div>
  }

  @if (Model.Terminal.Tipo == TipoTerminal.PcComun)
  {
    @* PC común: solo con la tarjeta, por el lector USB o la cámara; no se puede teclear el número.
       El nº leído va en un campo oculto (terminal.js / camara.js) y se envía solo. *@
    <form method="post" asp-page-handler="Leer" class="form-codigo form-lector" data-lector
          data-selector-camara="@(Model.SelectorCamara ? "1" : "0")">
      <svg class="icono-lector" viewBox="0 0 64 40" aria-hidden="true">
        <path d="M4 4h3v32H4zM10 4h2v32h-2zM15 4h4v32h-4zM22 4h2v32h-2zM27 4h3v32h-3zM33 4h2v32h-2zM38 4h4v32h-4zM45 4h2v32h-2zM50 4h3v32h-3zM56 4h4v32h-4z" />
      </svg>
      <p class="titulo-lector" data-titulo-lector>Pase su tarjeta por el lector</p>
      <input type="hidden" name="codigo" />
      <p class="alerta aviso" data-solo-tarjeta hidden>Use su tarjeta en el lector o en la cámara: no se puede teclear el número.</p>

      @* Tablet: lectura con la cámara (wwwroot/js/camara.js). *@
      <div class="camara" data-camara hidden>
        <div id="lector"></div>
        <select id="camaras" aria-label="Cámara" hidden></select>
      </div>
      <p class="alerta aviso" data-aviso-camara hidden></p>
      <button type="button" class="secundario" id="btnCamara">📷 Usar la cámara</button>
    </form>
    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script src="~/js/camara.js" asp-append-version="true"></script>
  }
  else if (Model.Empleado is not null)
  {
    <div class="empleado">
      <div class="codigo">@Model.Empleado.MP_CODI</div>
      <div class="nombre">@Model.Empleado.Descripcion</div>
    </div>

    <form method="post" asp-page-handler="Fichar" class="form-fichar">
      <button type="submit" class="boton-fichar @(Model.TocaEntrada ? "entrada" : "salida")" autofocus>
        @(Model.TocaEntrada ? "ENTRADA" : "SALIDA")
      </button>
    </form>

    <h2>Marcajes de hoy</h2>
    @if (Model.Marcajes.Count == 0)
    {
      <p class="detalle">Todavía no hay marcajes hoy.</p>
    }
    else
    {
      <table>
        <thead><tr><th>Hora</th><th>Tipo</th><th>Localización</th></tr></thead>
        <tbody>
          @foreach (var m in Model.Marcajes)
          {
            <tr>
              <td>@m.HoraTexto</td>
              <td><span class="tipo @(m.ENTRADA == 0 ? "entrada" : "salida")">@m.Tipo</span></td>
              <td>@m.DESC_LOCA</td>
            </tr>
          }
        </tbody>
      </table>
    }
  }
</div>
