@page
@model ErrorModel
@{ ViewData["Title"] = "Error"; }

<div class="panel cerrado">
  <h1>Se ha producido un error</h1>
  <p>@Model.Mensaje</p>
  <p class="detalle">Si el problema continúa, avise al administrador.</p>
  @if (!string.IsNullOrEmpty(Model.Detalle))
  {
    <pre style="text-align:left;white-space:pre-wrap;font-size:.75rem;">@Model.Detalle</pre>
  }
  <a href="~/" class="boton secundario">Volver</a>
</div>
