<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FerroliTime.Terminal</RootNamespace>
    <AssemblyName>FerroliTime.Terminal</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- La plantilla de configuración es para el repositorio, no para el servidor. -->
    <Content Update="appsettings.example.json" CopyToPublishDirectory="Never" />
    <!-- El appsettings.json del servidor (contraseñas de producción) no se sobrescribe al publicar. -->
    <!-- appdata\ (appsettings.json que edita Configuración) tampoco: se conserva la del servidor. -->
    <Content Update="appdata\**" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
